DATA_DIR=./data
MAX_UPLOAD_MB=25
DEFAULT_PROVIDER=mock            # switch to "ukp" once credentials are set
CORS_ORIGINS=http://localhost:5173

# UKP inference API (assumed OpenAI-compatible: POST {base}/chat/completions, Bearer auth)
UKP_API_BASE=
UKP_API_KEY=
UKP_MODEL=Qwen3.8-27B            # use the exact model id the UKP API expects

# Optional OpenAI-compatible provider
OPENAI_COMPAT_API_BASE=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
